{
    "defaultMode": "acceptEdits",
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Glob",
            "Grep",
            "TodoWrite",
            "Bash(npm start)",
            "Bash(npm run *)",
            "Bash(npm test *)",
            "Bash(npx ng *)",
            "Bash(npx prettier *)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(node *)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(git reset *)",
            "Bash(git checkout -- *)"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(del /f *)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/verify-ui.mjs"
                    }
                ]
            }
        ]
    }
}
