{
    "defaultMode": "acceptEdits",
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Glob",
            "Grep",
            "TodoWrite",
            "Bash(*)",
            "mcp__playwright__*"
        ],
        "deny": []
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/verify-ui.mjs"
                    }
                ]
            }
        ]
    }
}
